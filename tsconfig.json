{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "ES2025",
    "module": "esnext",
    "lib": ["ES2025", "DOM"],
    "types": ["node"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": { "@sky/*": ["./src/*"] }
  },
  "include": ["index.ts", "src", "test", "*.config.ts"]
}
